#!/usr/bin/env python3
# Stop: holds tasky replies to references/report.md.
# A reply after a task-ending set-status goes to a fresh reviewer, which cuts every line
# the user would not see the point of. Any other reply is checked for machine vocabulary,
# which is out of bounds in any user-facing reply. Only a hand-back of tracked-task work is
# held to the report form and to an exact next step; a chat answer is sent back for plain
# words in its own shape.
#
# Inert unless a tasky.md is in force. Never fires on a term the user used first, so
# answering a question about `manage_tasks.py` stays legal. Fenced code is exempt.
# Set TASKY_REPORT_FORM=off in the environment to disable.

import json
import os
import pathlib
import re
import sys

DATA_ROOT = '.agents/tasky/'

FORBIDDEN = [
    (r'\bset-status\b', 'the set-status command'),
    (r'\b(?:manage|view)_\w+\.py\b', 'a tasky script filename'),
    (r'^\s*-\s*\[[ xX]\]', 'a raw criterion checkbox'),
    (r'\bcriteri(?:on|a)\s+\d', 'a criterion number'),
    (r'^\s*STATUS:\s*(?:COMPLETE|BLOCKED|DOING|READY|DONE|PAUSED|PENDING)\s*$', 'a raw status line'),
    (r'\b\d{2}-[a-z0-9]+(?:-[a-z0-9]+)+\b(?!\.md)', 'a directory slug'),
    (re.escape(DATA_ROOT), 'an internal path'),
    (r'\b(?:READY|DOING(?! NOW:)|PAUSED)\b', 'a raw task status'),
    (r'\bcriteria (?:met|checked|verified)\b|\d+\s*/\s*\d+ criteria', 'a criteria tally'),
    (r'\bgates? (?:all )?(?:green|0|clean)\b', 'gate mechanics'),
    (r'\d+\s*(?:→|->)\s*\d+ tests\b', 'a test-count delta'),
    (r'\b(?:sub-agent|the receipt)\b', 'an internal actor'),
]

# A tasky script call that ends work on a task. The reply after it is a hand-back.
TASK_END = re.compile(
    r'''(?:^|[;&|]\s*)python3?\s+(?:"[^"\n]*|'[^'\n]*|\S*)manage_tasks\.py["']?\s+set-status\b[^\n]*?\s(?:ready|paused|done)\b''',
    re.M,
)


def ending_command(block):
    # The Bash command in a tool_use block when it ends a task, else ''.
    if not isinstance(block, dict) or block.get('type') != 'tool_use' or block.get('name') != 'Bash':
        return ''
    command = str(block.get('input', {}).get('command', ''))
    return command if TASK_END.search(command) else ''


# A tasky script subcommand that changes tasks (list and show only read), or a shell write under
# the data root: the turn worked on tracked tasks.
TASKY_WRITE = re.compile(
    r'''\bmanage_\w+\.py["']?\s+(?!list\b|show\b|-)\w'''
    r'|(?:\bsed\s+-i|\b(?:mv|rm|cp|tee|touch|mkdir|ln)\s|>>?\s*)[^|;&\n]*' + re.escape(DATA_ROOT)
)
WRITE_TOOLS = {'Edit', 'Write', 'MultiEdit', 'NotebookEdit', 'mcp__lean-ctx__ctx_edit', 'mcp__lean-ctx__ctx_patch'}
SHELL_TOOLS = {'Bash', 'mcp__lean-ctx__ctx_shell'}
# The turn answers an agent's finished run, not a message the user typed or a background command's end.
AGENT_MESSAGE = r'\s*(?:<task-notification>.*?<summary>Agent |Another Claude session sent a message:)'


def changes_tasks(block):
    if not isinstance(block, dict) or block.get('type') != 'tool_use':
        return False
    name, args = block.get('name', ''), block.get('input', {}) or {}
    if name in SHELL_TOOLS:
        return bool(TASKY_WRITE.search(str(args.get('command', ''))))
    if name in WRITE_TOOLS:
        return DATA_ROOT in str(args.get('file_path') or args.get('path') or '')
    return False


def tasky_config():
    # The tasky.md in force, or None.
    root = pathlib.Path(os.environ.get('CLAUDE_PROJECT_DIR', '.')).resolve()
    for parent in [root, *root.parents]:
        for name in ('tasky.md', DATA_ROOT + 'tasky.md'):
            if (parent / name).is_file():
                return parent / name
    return None


def tasky_in_force():
    return tasky_config() is not None


# This hook's own send-back, as the transcript records it. Hook feedback and agent hand-backs
# are meta entries, so a turn runs from the user's last real message across all of them.
SENT_BACK = re.compile(r'Stop hook feedback:\s*(REPORT REVIEW|REPORT FORM VIOLATION)\b')
MAX_SEND_BACKS = 3  # after three form send-backs in a turn, the reply reaches the user; the review is not one


# A status this turn set on a task, by any shell.
SET_STATUS = re.compile(r'manage_tasks\.py["\']?\s+set-status\b[^\n]*?\s(todo|pending|doing|ready|paused|done)\b')


def set_statuses(block):
    if not isinstance(block, dict) or block.get('type') != 'tool_use' or block.get('name') not in SHELL_TOOLS:
        return set()
    return set(SET_STATUS.findall(str((block.get('input') or {}).get('command', ''))))


def transcript_tail(path):
    # Returns (newest assistant reply, newest user message, the command that ended a task this
    # turn, whether this turn changed tasks, this hook's send-backs this turn, whether a review
    # was asked for after the task ended, the statuses this turn set).
    try:
        lines = open(path, encoding='utf-8').read().splitlines()
    except OSError:
        return '', '', '', False, 0, False, set()

    def text_of(entry):
        blocks = entry.get('message', {}).get('content', [])
        if isinstance(blocks, str):
            return blocks
        return '\n'.join(
            b.get('text', '') for b in blocks
            if isinstance(b, dict) and b.get('type') == 'text'
        )

    reply = prompt = ''
    ended = ''
    worked = reviewed = False
    sent = 0
    set_now = set()
    for line in reversed(lines):
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if entry.get('isSidechain'):
            continue
        kind = entry.get('type')
        if kind == 'assistant':
            if not reply:
                reply = text_of(entry)
            blocks = entry.get('message', {}).get('content', [])
            if isinstance(blocks, list):
                ended = next((c for c in map(ending_command, blocks) if c), ended)
                worked = worked or any(map(changes_tasks, blocks))
                set_now.update(*map(set_statuses, blocks))
        elif kind == 'user' and entry.get('isMeta'):
            back = SENT_BACK.match(text_of(entry))
            if back:
                sent += back.group(1) == 'REPORT FORM VIOLATION'
                # Walking back, no ending command seen yet: this review came after the task ended.
                reviewed = reviewed or (back.group(1) == 'REPORT REVIEW' and not ended)
        elif kind == 'user':
            text = text_of(entry)
            if text.strip():
                prompt = text
                break
    return reply, prompt, ended, worked, sent, reviewed, set_now


def strip_code(text):
    return re.sub(r'^```.*?^```', '', text, flags=re.M | re.S)


def strip_links(text):
    # A link's target is an address the user follows, not vocabulary: a slug in a URL is the page's name.
    text = re.sub(r'\[([^\]]*)\]\([^)\s]*\)', r'\1', text)
    return re.sub(r'<?\b(?:https?|ftp)://[^\s>)\]]+>?', '', text)


# Inside a hand-back, a line about the work itself has no consequence for the user: it is a
# note to whoever builds next. This is the one line-content check.
WORK_LOG = re.compile(
    r"\bI(?:'ve| have)? (?:ran|run|confirmed|verified|checked|tested|re-ran|proved|"
    r"fixed|wrote|added|updated|recorded|traced)\b"
    r"|\b(?:suites?|tests?|build|typecheck|lint)\b[^.\n]*\b(?:all )?(?:green|pass(?:es|ed|ing))\b",
    re.I,
)

# Inside a hand-back, a prompt to commit or push, or a pointer at other tasks waiting, stands
# where the one exact next step belongs. Commit and push happen when the user asks.
GIT = r'(?:commit(?:ted|s)?|push(?:ed|es)?)'
COUNT = r'(?:\d+|one|two|three|four|five|six|seven|eight|nine|ten|several|a few|other|more|(?:the )?remaining)'
# Each: the pattern, its name, and the user's own topic that makes it an answer, not a nag.
NEXT_STEP = [
    (re.compile(
        rf'\bsay\b[^.\n]{{0,60}}\b(?:to|and I(?:\'ll| will))\s+{GIT}\b|\bsay\s+["“]?{GIT}\b|["“]{GIT}["”]'
        rf'|\b(?:want me to|shall I|should I|ready to|let me know)\b[^.\n?]{{0,40}}\b{GIT}\b'
        rf'|\b{GIT}\b[^.\n]{{0,40}}\b(?:when|until|once) you (?:say|ask|want|tell|are)', re.I),
     'a prompt to commit or push', re.compile(rf'\b{GIT}\b', re.I)),
    (re.compile(
        rf'(?:^|[.:]\s+|^\s*-\s+(?:\w+:\s+)?)(?:the\s+)?{COUNT}\s+(?:\w+\s+)?tasks?\b[^.\n]{{0,40}}'
        r'\b(?:waiting|remain|left|to go|queued)\b|\b(?:more|others) (?:remain|are waiting)\b', re.I | re.M),
     'a pointer at other tasks waiting', re.compile(r'\b(?:left|remains?|remaining|waiting|how many)\b', re.I)),
    (re.compile(
        r'\b(?:reply|say|tell me)\b[^.\n]{0,15}\b(?:done|close[sd]?|complete)\b'
        r'|\bclos(?:e|ing)\b[^.\n]{0,40}\btasks?\b'
        r'|\b(?:mark(?:s|ing)?|confirm|sign off)\b[^.\n]{0,40}\b(?:done|complete)\b', re.I),
     'a prompt to close or mark a task done', re.compile(r'\b(?:clos(?:e|ing)|mark)\b', re.I)),
]


def next_step_violation(body, prompt):
    for pattern, name, asked in NEXT_STEP:
        match = pattern.search(body)
        if match and not asked.search(prompt):
            return name, match.group(0).strip()
    return None


def form_violation(body):
    # Only a reply that uses the form is held to it.
    match = re.search(r'^STATUS:', body, re.M)
    if not match:
        return None
    if body[:match.start()].strip():
        return 'text before the STATUS: line', body.strip().splitlines()[0][:60]

    # Allowed after STATUS: blank lines, "- fact" bullets at any depth, DOING NOW:, WAITING ON:,
    # NEXT: (THEN: after DOING NOW), DECIDE:, and a TEST IT: block of numbered steps.
    section = 'STATUS'
    doing = re.search(r'^\s*DOING NOW:', body, re.M)
    for line in body[match.start():].splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        head = re.match(r'(STATUS|DOING NOW|WAITING ON|NEXT|THEN|DECIDE|TEST IT):', stripped)
        if head:
            if head.group(1) == 'NEXT' and doing:
                return 'NEXT: after DOING NOW: — head what comes next THEN:', stripped[:60]
            if head.group(1) == 'THEN' and not doing:
                return 'THEN: with nothing running — head the steps NEXT:', stripped[:60]
            if head.group(1) == 'TEST IT' and section == 'THEN':
                return "the user's step under THEN: — it shows once the running work ends", stripped[:60]
            fact = stripped[head.end():].strip()
            section = head.group(1)
        elif CHECK_HEAD.match(stripped):
            section = 'CHECKLIST'
            continue
        elif section == 'CHECKLIST' and CHECK_ITEM.match(stripped):
            continue
        elif stripped.startswith('- '):
            if section == 'THEN' and stripped.startswith('- You:'):
                return "the user's step under THEN: — it shows once the running work ends", stripped[:60]
            fact = stripped[2:]
        elif re.match(r'\d+\. ', stripped):
            fact = stripped.split(' ', 1)[1]
        elif re.match(r'[A-Z][A-Z ]{2,}:', stripped):
            return 'a section the form does not have', stripped[:60]
        else:
            return 'a line outside the form — each point goes in a bullet', stripped[:60]

        log = WORK_LOG.search(fact)
        if log and not re.search(r'\b(?:should|will|expect)\b', fact, re.I):
            return 'a line about the work with no consequence for the user', log.group(0)
    if not doing and not re.search(r'^\s*(?:NEXT:|DECIDE:)', body, re.M):
        return ('no word on what moves it on — DOING NOW: with who runs it, or NEXT: naming the '
                'next task'), body[match.start():].splitlines()[0][:60]
    return None


# The checklist under STATUS: a status or Committed heading, a box per task under it.
CHECK_HEAD = re.compile(r'^(TODO|PENDING|DOING|READY|PAUSED|DONE|Committed)$')
CHECK_ITEM = re.compile(r'^\[([ x])\] (.+)$')
CHECK_HEADS = re.compile(r'^[ \t]*(?:TODO|PENDING|DOING|READY|PAUSED|DONE|Committed)[ \t]*$', re.M)


def plain(name):
    return re.sub(r'\s+', ' ', name.strip().strip('`*"').strip()).lower()


def data_root():
    config = tasky_config()
    if not config:
        return None
    return config.parent if str(config).endswith(DATA_ROOT + 'tasky.md') else config.parent / DATA_ROOT


def task_titles(folder=None):
    # {status: {plain title}} for every task file outside backups, under folder or the data root.
    found = {}
    root = folder or data_root()
    if not root or not root.is_dir():
        return found
    for path in root.rglob('*.md'):
        if '.bak' in str(path):
            continue
        try:
            head = path.read_text(encoding='utf-8')[:600]
        except OSError:
            continue
        status = re.search(r'^Status:\s*([A-Z]+)\s*$', head, re.M)
        title = re.search(r'^#\s+(.+?)\s*$', head, re.M)
        if status and title:
            found.setdefault(status.group(1), set()).add(plain(title.group(1)))
    return found


def checklist(body):
    # [(heading, [(checked, name)])]
    rows, row = [], None
    for line in body.splitlines():
        stripped = line.strip()
        head = CHECK_HEAD.match(stripped)
        item = CHECK_ITEM.match(stripped)
        if head:
            row = (head.group(1), [])
            rows.append(row)
        elif row and item:
            row[1].append((item.group(1) == 'x', item.group(2)))
        elif stripped:
            row = None
    return rows


def ended_milestone(command):
    # The milestone folder of the task an ending set-status names.
    args = command.split('set-status', 1)[-1].split()
    root = data_root()
    if len(args) < 5 or not root:
        return None
    for path in root.glob(f'**/{args[3]}/{args[4]}.md'):
        return path.parent
    return None


def checklist_violation(body, ended, set_now):
    if not re.search(r'^STATUS:', body, re.M):
        return None
    rows = checklist(body)
    first = body.strip().splitlines()[0][:60]
    if ended and not rows:
        return 'a task hand-back with no checklist under STATUS', first
    if not rows:
        return None
    seen = {}
    for label, items in rows:
        for checked, name in items:
            if checked and label != 'Committed':
                if plain(name) in seen and seen[plain(name)] != label:
                    return f'a task checked under both {seen[plain(name)]} and {label}; a task stands at one status', name
                seen[plain(name)] = label
    for status in sorted(set_now & {'ready', 'paused', 'done'}):
        if not any(l == status.upper() and any(c for c, _ in items) for l, items in rows):
            return f'a task this turn set to {status.upper()} with no "[x] task" under {status.upper()}', first
    tasks = task_titles()
    known = set().union(*tasks.values()) if tasks else set()
    for label, items in rows:
        if not items:
            return 'a checklist heading with no "[x] task" or "[ ] task" under it', label
        if label == 'Committed':
            for _, name in items:
                parts = [p.strip() for p in name.split(' / ')]
                if not (len(parts) == 3 or (len(parts) == 2 and parts[0] == 'main')):
                    return 'a Committed entry not written "<worktree> / <branch> / <task>" or "main / <task>"', name
                if plain(parts[-1]) not in known:
                    return 'a Committed entry naming no task by its title', name
            continue
        standing = tasks.get(label, set())
        for checked, name in items:
            if not checked:
                if plain(name) in standing:
                    return f'a task at {label} left unchecked under {label}', name
                continue
            if label != 'READY' and label.lower() not in set_now:
                return f'a checked task under {label}, a status no task took this turn', name
            if plain(name) not in standing:
                return f'a task checked under {label} that does not stand at {label}', name
    checked_ready = {plain(n) for l, items in rows if l == 'READY' for c, n in items if c}
    folder = ended and ended_milestone(ended)
    if folder:
        left = sorted(task_titles(folder).get('READY', set()) - checked_ready)
        if left:
            return 'a task in this milestone at READY left off READY', left[0]
    return None


def violation(reply, prompt, ended=False, handback=False, set_now=frozenset()):
    body = strip_code(reply)
    if ended and body.strip() and not re.search(r'^STATUS:', body, re.M):
        return 'a task hand-back with no STATUS: line', body.strip().splitlines()[0][:60]
    found = handback and next_step_violation(body, prompt)
    if found:
        return found
    found = form_violation(body) or checklist_violation(body, ended, set_now)
    if found:
        return found
    body = strip_links(CHECK_HEADS.sub('', body))
    for pattern, name in FORBIDDEN:
        match = re.search(pattern, body, re.M)
        if not match:
            continue
        # The user raised it first — answering them is not a leak.
        if re.search(pattern, prompt, re.M):
            continue
        return name, match.group(0).strip()
    return None



REVIEWER = """\
You review a task report before its reader sees it. Output only the final report.

The reader is the user: one person at a terminal who saw none of the work and knows
only this task's goal. Test every line of the draft: does it say something that
matters to the user, knowing only this task's goal and their own last message? A
line with no consequence for them is cut: what was run or checked, how something
works inside, another task's work, a warning that changes nothing they do now. A
reason stays when it tells the user what the result means for them. The NEXT line
names the one exact next step: the next task by its plain name and what doing it
will produce; it stays, even when it names another task. A prompt to commit or push,
or to close or mark a task done, is cut wherever it sits: the user does those when
they choose. A count of tasks left, or other tasks waiting, is cut too.

Cut; never add a fact. Reword a kept line only to drop a part with no consequence
for the user, or to put it in words the user would use instead of the builder's.
Never drop the words that say a result is wrong, partial or unfinished; without them
the fact is false. A line that tells the user how to see the work moves into TEST IT.
Keep the shape:

STATUS: <what the result means for the user, one short sentence>

- <a fact>
  - <a detail of that fact>

READY
  [x] <task>
Committed
  [ ] <worktree> / <branch> / <task>

DOING NOW:
- You: <a step the user can take meanwhile>
- <who: Me, Agent, Pi, GPT, BG or another>: <work running right now>

WAITING ON:
- <what holds the next step: an outside run, another person>

NEXT:  (THEN: when DOING NOW is shown)
  TEST IT:
    1. <what to do>
    2. <what to do>

    - <what you should see>
- Me: <my next step toward this task's goal>

DECIDE: <the choice, in terms of what the user would notice>
  - <option>: <what it changes for them>
  - <option>: <what it changes for them>

STATUS stays first and says what the result means for the user, in plain words. A draft
whose words read as finished for unfinished work is reworded. A second point is its own
bullet. The checklist (a READY, PAUSED or other status heading, or a Committed heading,
each with "[x] task" or "[ ] task" lines under it) stays exactly as the draft gives it,
right after STATUS and its bullets; it is the one place git state may show. Drop a section left empty. Every step line starts with who acts, the user's
steps first: "You:" the user; "Me:" this chat; "Agent:" an agent this chat started;
"Pi:" a pi run; "GPT:" a Codex run; "BG:" a command running in the background;
anyone or anything else, by a short name for it ("CI:", a person's name). DOING
NOW holds each of those running at this moment, and any step the user can take
meanwhile. With DOING NOW shown, THEN names what comes after it: the next step and
who takes it, or the next task; never a step of the user's, which shows once the
running work ends. With nothing running, the steps go under NEXT. Either holds only
steps no one has started. Every report shows what moves the work on: DOING NOW
with who runs it, NEXT naming the next task and what it produces, or DECIDE; a
draft with none gets a NEXT line for the next task it names, the one line you may
add. WAITING ON lists only what is
outside the session and holds a later step: an outside run, another person. The
user's answer is a DECIDE. When the next step is the user trying the work, NEXT holds
a TEST IT: block: numbered actions, then what they see.

DECIDE stays only in that shape, built from facts the draft gives, and only when the
work needs a fact only the user holds, every course open contradicts the user's goal
or an earlier decision, or the choice sets a direction costly to undo (an
architecture's shape, a program's structure) with more than one sound course left
after the builder tried the work. A choice easy to undo, closing a task, or a choice
the draft names only in code terms, is cut. A DECIDE, or a "reply X" or "say X to
start" line, offering an option the draft recommends, or a question the user already
settled, becomes that option as the NEXT "Me:" step. A line telling a choice the
builder made, or the options it weighed, is cut unless the choice could contradict
the user's goal or an earlier decision, or cause a problem they would hit.

== TASK FILE ==
{task}

== THE USER'S LAST MESSAGE ==
{prompt}

== DRAFT REPORT ==
{reply}
"""


def task_file(command):
    # The task file an ending set-status command names, as text.
    args = command.split('set-status', 1)[-1].split()
    if len(args) < 5:
        return '(not found)'
    milestone, slug = args[3], args[4]
    config = tasky_config()
    roots = [config.parent, config.parent / DATA_ROOT] if config else []
    for root in roots:
        for path in root.glob(f'**/{milestone}/{slug}.md'):
            return path.read_text(encoding='utf-8')[:6000]
    return '(not found)'


def review_brief(reply, prompt, command):
    # The reviewer's whole brief, handed over in the open: the agent's prompt is the brief itself.
    return REVIEWER.format(task=task_file(command), prompt=prompt.strip()[:3000], reply=reply.strip())


def main():
    if os.environ.get('TASKY_REPORT_FORM', '').lower() in ('off', '0', 'false'):
        return
    if not tasky_in_force():
        return
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return
    if payload.get('stop_hook_active'):
        return

    reply, prompt, ended, worked, sent, reviewed, set_now = transcript_tail(payload.get('transcript_path', ''))
    reply = payload.get('last_assistant_message') or reply
    if sent >= MAX_SEND_BACKS:
        return

    # A hand-back goes to a fresh reviewer before the user reads it, once: the reviewed report goes on.
    if ended and reply.strip() and not reviewed:
        brief = review_brief(reply, prompt, ended)
        print(json.dumps({
            'decision': 'block',
            'reason': (
                'REPORT REVIEW (set up by the user in ~/.claude/hooks/tasky-report-gate): a task report '
                'goes to a fresh reviewer before the user reads it. Spawn one Agent (model "sonnet") whose '
                'prompt is the brief between the markers below, word for word. Wait for its result, then '
                'reply to the user with the report it returns.\n\n=== BRIEF ===\n' + brief + '\n=== END BRIEF ==='
            ),
        }))
        return

    # The report form is for handing back tracked-task work: this turn's or a finished agent's.
    # A chat answer keeps its own shape.
    handback = bool(worked or re.match(AGENT_MESSAGE, prompt, re.S))
    found = violation(reply, prompt, ended, handback, set_now)
    if not found:
        return

    name, snippet = found
    if handback or re.search(r'^STATUS:', strip_code(reply), re.M):
        rewrite = (
            'Rewrite it for them: STATUS: first, saying what the result means for them, then "- " '
            'bullets, then the checklist as tasky\'s references/report.md gives it, each task checked '
            'only under the status it stands at now: a READY heading with "[x] <title>" for every task '
            'of this milestone at READY ("[ ] <title>" for this task when it is not at READY and not '
            'closed), a heading for the status this turn set (DONE, PAUSED), and a Committed heading '
            'with "[x]" or "[ ]" and "<worktree> / <branch> / <task>" or "main / <task>", headings '
            'with no task left out; then DOING NOW:, WAITING ON: and NEXT: (THEN: after DOING NOW, never a step of theirs) only if they have content, DECIDE: only '
            'for a choice tasky\'s SKILL.md Deciding lets surface; an option you would recommend is a '
            'step you take, never a choice, and a choice you made goes unsaid unless Deciding 5 keeps it. '
            'Cut a line with no consequence for them. Never '
            'ask to commit, push, close or mark a task done (they do those when they choose) or point at '
            'other tasks waiting or how many are left; name the one exact next step: which task, by its '
            'plain name, and what doing it will produce.'
        )
    else:
        rewrite = ('Say that part in the words the user would use, and give the whole answer again '
                   'in its own shape, every fact kept.')
    print(json.dumps({
        'decision': 'block',
        'reason': (
            f'REPORT FORM VIOLATION: the reply shows {name} ("{snippet}") to a reader '
            f'who saw none of the work. {rewrite} Say nothing about this rewrite.'
        ),
    }))


if __name__ == '__main__':
    main()
